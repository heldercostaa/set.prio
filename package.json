{
  "name": "set.priority",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A personal planner for Tomorrowland Brasil 2027. Discover artists, prioritize performances by day, rate recommended YouTube sets, and export your plan as an image, CSV, or Notion table. Preferences are saved locally in your browser; no account or backend required.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "bddgen && playwright test --project=contracts",
    "test:e2e": "bddgen && playwright test --project=chromium --project=webkit --project=mobile-chromium --project=mobile-webkit",
    "icons": "node scripts/generate-icons.mjs",
    "catalog:refresh": "node scripts/update-catalog.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "playwright-bdd": "9.2.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
